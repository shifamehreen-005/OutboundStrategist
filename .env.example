# Copy this file to .env and fill in your keys.
# The app loads .env automatically at startup (python-dotenv).
# Shell environment variables take precedence over .env values.

# ── Required for live mode ────────────────────────────────────────────────────
# Without this key the app runs in MOCK_MODE (deterministic fixtures, no cost).
ANTHROPIC_API_KEY=sk-ant-...

# ── Recommended: stable web search ───────────────────────────────────────────
# When set, all web search routes through Tavily (concurrent, deterministic).
# Without it the app falls back to Claude's native web_search tool.
# Get a free key at: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001
# MOCK_MODE=0
# CUSTOMER_WEB_SEARCH=1
# CUSTOMER_WEB_MAX_SEARCHES=5
# JS_RENDER_THRESHOLD=600
# ENRICH_THRESHOLD=2000
